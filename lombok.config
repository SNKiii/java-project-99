lombok.addLombokGeneratedAnnotation = true
lombok.anyConstructor.addConstructorProperties = true
mapstruct.defaultComponentModel = spring
lombok.copyableAnnotations += org.mapstruct.Mapper
lombok.copyableAnnotations += org.mapstruct.Mapping
lombok.copyableAnnotations += org.mapstruct.MappingTarget
lombok.copyableAnnotations += org.mapstruct.Named
